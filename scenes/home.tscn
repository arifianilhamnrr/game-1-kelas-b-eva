[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/ui/home.gd" id="1_home"]
[ext_resource type="Texture2D" path="res://assets/Background/Green.png" id="2_bg"]

[sub_resource type="StyleBoxFlat" id="StyleButtonNormal"]
bg_color = Color(0.18, 0.29, 0.25, 0.78)
corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_right = 2
corner_radius_bottom_left = 2

[sub_resource type="StyleBoxFlat" id="StyleButtonHover"]
bg_color = Color(0.25, 0.41, 0.34, 0.95)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.8, 1, 0.85, 0.75)
corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_right = 2
corner_radius_bottom_left = 2

[node name="Home" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_home")

[node name="Background" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("2_bg")
texture_repeat = 2
stretch_mode = 1

[node name="Tint" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.71, 0.91, 0.69, 0.42)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Menu" type="VBoxContainer" parent="Center"]
custom_minimum_size = Vector2(520, 0)
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Center/Menu"]
layout_mode = 2
theme_override_colors/font_color = Color(0.82, 0.08, 0.07, 1)
theme_override_colors/font_shadow_color = Color(0.2, 0.1, 0.05, 0.25)
theme_override_constants/shadow_offset_x = 2
theme_override_constants/shadow_offset_y = 2
theme_override_font_sizes/font_size = 39
text = "GAME 1\nEVA NUR HALISA\nKELAS B"
horizontal_alignment = 1

[node name="TitleSpacing" type="Control" parent="Center/Menu"]
custom_minimum_size = Vector2(0, 26)
layout_mode = 2

[node name="StartButton" type="Button" parent="Center/Menu"]
unique_name_in_owner = true
custom_minimum_size = Vector2(520, 90)
layout_mode = 2
focus_neighbor_bottom = NodePath("../ExitButton")
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_hover_color = Color(1, 1, 1, 1)
theme_override_colors/font_focus_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 27
theme_override_styles/normal = SubResource("StyleButtonNormal")
theme_override_styles/hover = SubResource("StyleButtonHover")
theme_override_styles/pressed = SubResource("StyleButtonHover")
theme_override_styles/focus = SubResource("StyleButtonHover")
text = "START"

[node name="ExitButton" type="Button" parent="Center/Menu"]
custom_minimum_size = Vector2(520, 90)
layout_mode = 2
focus_neighbor_top = NodePath("../StartButton")
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_hover_color = Color(1, 1, 1, 1)
theme_override_colors/font_focus_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 27
theme_override_styles/normal = SubResource("StyleButtonNormal")
theme_override_styles/hover = SubResource("StyleButtonHover")
theme_override_styles/pressed = SubResource("StyleButtonHover")
theme_override_styles/focus = SubResource("StyleButtonHover")
text = "EXIT"

[connection signal="pressed" from="Center/Menu/StartButton" to="." method="_on_start_button_pressed"]
[connection signal="pressed" from="Center/Menu/ExitButton" to="." method="_on_exit_button_pressed"]
